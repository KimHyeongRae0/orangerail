# Working notes, tickets, drafts and handoffs are local-only by convention.
# This is what enforces it: a stray `git add -A` must never publish them.
.docs/
# Agent worktrees and local agent settings.
.claude/
node_modules/
dist/
# bench fixtures ship the recipe, never the output: databases are seeded from
# `_build/seed.mjs`, and `runs/` holds a whole project copy plus a transcript per run.
*.db
bench/*/runs/
bench/*/_build/_queue.md
bench/**/package-lock.json
