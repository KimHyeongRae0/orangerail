generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Customer {
  id      String        @id
  name    String
  email   String
  ledger  LedgerEntry[]
  tickets SupportTicket[]
}

model LedgerEntry {
  id         String   @id
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])
  kind       String   // "charge" | "refund" | "adjustment" | "reversal"
  amountCents Int     // signed: charges positive, refunds negative
  memo       String
  createdAt  DateTime @default(now())
}

model SupportTicket {
  id         String    @id
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])
  subject    String
  body       String
  status     String    // "open" | "closed"
  createdAt  DateTime  @default(now())
  closedAt   DateTime?
}
