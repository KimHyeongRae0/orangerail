{
  "name": "orangerail",
  "version": "0.1.5",
  "type": "module",
  "mcpName": "io.github.KimHyeongRae0/orangerail",
  "description": "Generate an MCP server from your Prisma schema — typed per-model tools instead of execute_sql, destructive writes gated behind human approval, every action on an audit log. Plus the operator surface: approvals, audit verify, status, studio.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "prisma",
    "ai-agent",
    "database",
    "approval",
    "human-in-the-loop",
    "destructive",
    "audit-log",
    "cli"
  ],
  "license": "MIT",
  "author": "HyeongRae Kim",
  "homepage": "https://github.com/KimHyeongRae0/orangerail#readme",
  "bugs": "https://github.com/KimHyeongRae0/orangerail/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KimHyeongRae0/orangerail.git",
    "directory": "packages/cli"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "orangerail": "./dist/main.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsup"
  },
  "dependencies": {
    "orangerail-core": "workspace:*",
    "orangerail-docs-gen": "workspace:*",
    "orangerail-mcp": "workspace:*",
    "orangerail-studio": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "zod": "^3.23.0"
  }
}
