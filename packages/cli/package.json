{
  "name": "orangerail",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "orangerail cli (npm bin `orangerail`): approvals list/show/approve/reject, audit verify, store unlock, mcp server launcher",
  "bin": {
    "orangerail": "./dist/main.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
