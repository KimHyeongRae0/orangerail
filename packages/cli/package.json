{
  "name": "orangerail",
  "version": "0.1.1",
  "type": "module",
  "description": "orangerail cli (npm bin `orangerail`): scan a repo into a governed MCP server (init/sync), launch it (mcp), and run the operator surface — approvals, audit verify, status, studio, docs, store unlock",
  "keywords": [
    "ontology",
    "agent",
    "governance",
    "mcp",
    "cli",
    "typescript"
  ],
  "license": "MIT",
  "author": "HyeongRae Kim",
  "homepage": "https://github.com/KimHyeongRae0/orangerail#readme",
  "bugs": "https://github.com/KimHyeongRae0/orangerail/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KimHyeongRae0/orangerail.git",
    "directory": "packages/cli"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "orangerail": "./dist/main.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsup"
  },
  "dependencies": {
    "orangerail-core": "workspace:*",
    "orangerail-docs-gen": "workspace:*",
    "orangerail-mcp": "workspace:*",
    "orangerail-studio": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "zod": "^3.23.0"
  }
}
