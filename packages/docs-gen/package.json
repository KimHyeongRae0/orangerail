{
  "name": "orangerail-docs-gen",
  "version": "0.1.2",
  "type": "module",
  "description": "Generate the AGENTS.md an AI agent reads to learn which data tools and approval-gated write actions exist, deterministically, with a Mermaid diagram.",
  "keywords": [
    "mcp",
    "ai-agent",
    "documentation",
    "mermaid",
    "typescript"
  ],
  "license": "MIT",
  "author": "HyeongRae Kim",
  "homepage": "https://github.com/KimHyeongRae0/orangerail#readme",
  "bugs": "https://github.com/KimHyeongRae0/orangerail/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KimHyeongRae0/orangerail.git",
    "directory": "packages/docs-gen"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsup"
  },
  "dependencies": {
    "orangerail-core": "workspace:*"
  },
  "peerDependencies": {
    "zod": "^3.23 || ^4"
  },
  "devDependencies": {
    "jsdom": "^29.1.0",
    "mermaid": "^11.16.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "zod": "^3.23.0"
  }
}
