{
  "name": "orangerail-docs-gen",
  "version": "0.1.0",
  "type": "module",
  "description": "orangerail docs-gen: deterministically generate the agent-facing domain document (AGENTS.md sections + Mermaid diagram) from an ontology registry (prompt rail)",
  "keywords": [
    "ontology",
    "agent",
    "governance",
    "documentation",
    "mermaid",
    "typescript"
  ],
  "license": "MIT",
  "author": "HyeongRae Kim",
  "homepage": "https://github.com/KimHyeongRae0/orangerail#readme",
  "bugs": "https://github.com/KimHyeongRae0/orangerail/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KimHyeongRae0/orangerail.git",
    "directory": "packages/docs-gen"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsup"
  },
  "dependencies": {
    "orangerail-core": "workspace:*"
  },
  "peerDependencies": {
    "zod": "^3.23 || ^4"
  },
  "devDependencies": {
    "jsdom": "^29.1.0",
    "mermaid": "^11.16.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "zod": "^3.23.0"
  }
}
