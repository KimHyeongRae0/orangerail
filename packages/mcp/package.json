{
  "name": "orangerail-mcp",
  "version": "0.1.1",
  "type": "module",
  "description": "orangerail mcp: generate a governed MCP server (read tools + staged write-actions + approval re-check) from an ontology registry",
  "keywords": [
    "ontology",
    "agent",
    "governance",
    "mcp",
    "model-context-protocol",
    "typescript"
  ],
  "license": "MIT",
  "author": "HyeongRae Kim",
  "homepage": "https://github.com/KimHyeongRae0/orangerail#readme",
  "bugs": "https://github.com/KimHyeongRae0/orangerail/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KimHyeongRae0/orangerail.git",
    "directory": "packages/mcp"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsup"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "orangerail-core": "workspace:*"
  },
  "peerDependencies": {
    "zod": "^3.23 || ^4"
  },
  "devDependencies": {
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "zod": "^3.23.0"
  }
}
