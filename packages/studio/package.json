{
  "name": "orangerail-studio",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "orangerail studio: a local, read-only web app that renders the declared ontology as an interactive domain map (React Flow + ELK). Ships a prebuilt static app plus a node-consumable snapshot entry the CLI serves.",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/node/index.d.ts",
        "default": "./dist/node/index.js"
      }
    },
    "./snapshot": {
      "import": {
        "types": "./dist/node/index.d.ts",
        "default": "./dist/node/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "build": "vite build && tsup"
  },
  "dependencies": {
    "orangerail-core": "workspace:*",
    "@xyflow/react": "^12.11.0",
    "elkjs": "^0.12.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "peerDependencies": {
    "zod": "^3.23 || ^4"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "jsdom": "^29.1.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vite": "^8.1.0",
    "vitest": "^2.1.0",
    "zod": "^3.23.0"
  }
}
