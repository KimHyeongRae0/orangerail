{
  "name": "orangerail-studio",
  "version": "0.1.4",
  "type": "module",
  "description": "Local read-only web app mapping the objects, links and approval-gated write actions your MCP server exposes to an AI agent (React Flow + ELK).",
  "keywords": [
    "mcp",
    "ai-agent",
    "database",
    "read-only",
    "approval",
    "react-flow",
    "typescript"
  ],
  "license": "MIT",
  "author": "HyeongRae Kim",
  "homepage": "https://github.com/KimHyeongRae0/orangerail#readme",
  "bugs": "https://github.com/KimHyeongRae0/orangerail/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KimHyeongRae0/orangerail.git",
    "directory": "packages/studio"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/node/index.d.ts",
        "default": "./dist/node/index.js"
      }
    },
    "./snapshot": {
      "import": {
        "types": "./dist/node/index.d.ts",
        "default": "./dist/node/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "build": "vite build && tsup"
  },
  "dependencies": {
    "orangerail-core": "workspace:*"
  },
  "peerDependencies": {
    "zod": "^3.23 || ^4"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "@xyflow/react": "^12.11.0",
    "elkjs": "^0.12.0",
    "jsdom": "^29.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vite": "^8.1.0",
    "vitest": "^2.1.0",
    "zod": "^3.23.0"
  }
}
