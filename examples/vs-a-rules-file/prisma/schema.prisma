generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Order {
  id     String @id
  status String
  total  Int
}

model Customer {
  id    String @id
  name  String
  email String
}

model Product {
  id         String @id
  title      String
  status     String
  priceCents Int
}
